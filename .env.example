# Supabase (optional — magic link auth; session only in this phase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: set to "true" only if you intentionally enable legacy cloud sync of health payloads
# to Supabase `tracker_days`. Default is local-only for privacy-first builds.
# NEXT_PUBLIC_SYNC_HEALTH_TO_CLOUD=true

# Peloton (optional - auto-populate workout minutes)
# Option A: Settings → Peloton (requires PELOTON_CREDENTIALS_ENCRYPTION_KEY)
# Option B: Server env vars below (less secure, single user)
PELOTON_USERNAME=your-peloton-email
PELOTON_PASSWORD=your-peloton-password

# Required if using Settings-based Peloton connection (encrypt stored creds)
# Generate: openssl rand -base64 32
PELOTON_CREDENTIALS_ENCRYPTION_KEY=
